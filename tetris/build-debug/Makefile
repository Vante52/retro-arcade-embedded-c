	$(MAKE) $(MAKESILENT) -f CMakeFiles/tetris_terminal.dir/build.make CMakeFiles/tetris_terminal.dir/main_terminal.c.o
.PHONY : main_terminal.c.o

main_terminal.i: main_terminal.c.i
.PHONY : main_terminal.i

# target to preprocess a source file
main_terminal.c.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tetris_terminal.dir/build.make CMakeFiles/tetris_terminal.dir/main_terminal.c.i
.PHONY : main_terminal.c.i

main_terminal.s: main_terminal.c.s
.PHONY : main_terminal.s

# target to generate assembly for a file
main_terminal.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tetris_terminal.dir/build.make CMakeFiles/tetris_terminal.dir/main_terminal.c.s
.PHONY : main_terminal.c.s

